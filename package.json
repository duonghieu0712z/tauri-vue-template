{
    "name": "tauri-vue-template",
    "version": "1.0.3",
    "private": true,
    "author": "duonghieu0712z",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "build-only": "vite build",
        "type-check": "vue-tsc --noEmit",
        "start": "pnpm tauri dev",
        "make": "pnpm tauri build",
        "lint": "run-s lint:check:*",
        "lint:fix": "run-s lint:fix:*",
        "lint:check:oxlint": "oxlint .",
        "lint:check:eslint": "eslint . --cache",
        "lint:fix:oxlint": "oxlint --fix .",
        "lint:fix:eslint": "eslint --fix . --cache",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt .",
        "bump": "node scripts/bump-version.js",
        "prepare": "husky"
    },
    "dependencies": {
        "@lucide/vue": "^1.61.0",
        "@tauri-apps/api": "^2.12.4",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.0",
        "vue": "^3.5.44"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.12.4",
        "@tsconfig/node24": "^24.0.5",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.13.0",
        "eslint-plugin-oxlint": "^1.89.0",
        "eslint-plugin-vue": "^10.11.1",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.6.0",
        "npm-run-all2": "^9.0.4",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "picomatch": "^4.0.7",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "~6.0.3",
        "unplugin-auto-import": "^21.0.0",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^8.3.5",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vue-tsc": "^3.3.13"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "packageManager": "pnpm@12.9.1"
}
